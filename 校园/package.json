{
  "name": "qingning-campus",
  "version": "1.0.0",
  "private": true,
  "description": "青柠校园论坛 - Vue 3 + Express + SQLite",
  "scripts": {
    "dev": "concurrently -k \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "nodemon server/server.js",
    "client:dev": "vite --host 127.0.0.1",
    "start": "node server/server.js",
    "build": "vite build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "connect-sqlite3": "^0.9.16",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "vite": "^6.1.0"
  }
}